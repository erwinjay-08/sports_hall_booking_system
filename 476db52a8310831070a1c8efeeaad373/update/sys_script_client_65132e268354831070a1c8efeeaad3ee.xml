        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Past Start Date Warning</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) return;
    
    g_form.hideFieldMsg('start_date', true);
    
    if (newValue) {
        // Get today's date using client-side method
        var today = new Date();
        var selected = new Date(newValue);
        
        if (selected < today) {
            g_form.showFieldMsg('start_date',
            'Warning: Start Date/Time is in the past!',
            'warning');
        }
    }
}]]></script>
